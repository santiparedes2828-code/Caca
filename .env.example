# Hook House Autopilot — copia este archivo a .env (nunca subas .env a Git).
# Todas las variables son opcionales; estos son los valores por defecto.

# Carpetas (por defecto dentro del proyecto)
# HH_DATA_DIR=./data          # trabajos: data/clients/<cliente>/jobs/<id>/
# HH_INBOX_DIR=./inbox        # bandeja: inbox/<cliente>/
# HH_CLIENTS_DIR=./clients    # perfiles: clients/<cliente>/profile.json

# Límites
# HH_MAX_UPLOAD_MB=4096
# HH_MAX_DURATION_SEC=10800
# HH_MAX_ATTEMPTS=3

# Render
# HH_RENDER_CONCURRENCY=4     # pestañas de navegador en paralelo (por defecto: núcleos, máx. 4)
# HH_RENDER_TIMEOUT_MS=120000
# HH_QC_FRAMES=6
# REMOTION_BROWSER_EXECUTABLE=/ruta/a/chrome-headless-shell   # solo si Remotion no puede descargarlo
# REMOTION_LICENSE_KEY=        # licencia de empresa de Remotion, si aplica

# Etapa 4 (aún no se usa): ElevenLabs
# ELEVENLABS_API_KEY=
