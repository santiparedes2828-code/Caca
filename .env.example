# Hook House Autopilot — copia este archivo a .env (nunca subas .env a Git).
# Todas las variables son opcionales; estos son los valores por defecto.

# Carpetas (por defecto dentro del proyecto)
# HH_DATA_DIR=./data          # trabajos: data/clients/<cliente>/jobs/<id>/
# HH_INBOX_DIR=./inbox        # bandeja: inbox/<cliente>/
# HH_CLIENTS_DIR=./clients    # perfiles: clients/<cliente>/profile.json

# Límites
# HH_MAX_UPLOAD_MB=4096
# HH_MAX_DURATION_SEC=10800
# HH_MAX_ATTEMPTS=3

# Render
# HH_RENDER_CONCURRENCY=4     # pestañas de navegador en paralelo (por defecto: núcleos, máx. 4)
# HH_RENDER_TIMEOUT_MS=120000
# HH_QC_FRAMES=6
# REMOTION_BROWSER_EXECUTABLE=/ruta/a/chrome-headless-shell   # solo si Remotion no puede descargarlo
# REMOTION_LICENSE_KEY=        # licencia de empresa de Remotion, si aplica

# ElevenLabs — transcripción automática (Speech-to-Text, Scribe) cuando no hay SRT.
# Crea la clave en tu cuenta de ElevenLabs (sección de API keys). Si la restringes por permisos,
# incluye Speech to Text y lectura del usuario (para que `npm run autopilot -- elevenlabs` muestre tu plan).
# ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# HH_STT_MAX_SECONDS_PER_JOB=3600     # máximo de audio por trabajo (se rechaza ANTES de llamar a la API)
# HH_STT_MAX_SECONDS_PER_DAY=14400    # máximo diario entre todos los trabajos
# HH_STT_RETRIES=2                    # solo para 429/5xx/red; un timeout nunca se reintenta
# HH_STT_TIMEOUT_MS=900000
# HH_ELEVENLABS_STT_USD_PER_HOUR=     # precio por hora de TU plan, solo para estimar costes
# Detrás de un proxy corporativo, Node necesita NODE_USE_ENV_PROXY=1 para que fetch use HTTPS_PROXY.

# Claude (opcional): planificador de clips y guiones desde un brief
# ANTHROPIC_API_KEY=
# HH_CLAUDE_USD_PER_MTOK_IN=4      # tarifas para ESTIMAR coste (claude-opus-5-5); la factura manda
# HH_CLAUDE_USD_PER_MTOK_OUT=20

# Narración (texto a voz)
# HH_TTS_MAX_CHARS_PER_JOB=6000
# HH_TTS_MAX_CHARS_PER_DAY=60000

# Cola
# HH_QUEUE_CONCURRENCY=1           # trabajos a la vez (cada render ya usa varios núcleos)
# HH_QUEUE_AUTO_RETRIES=2
# HH_ALERT_PERCENT=80              # aviso cuando el uso diario pasa este % del límite

# Web (por defecto solo en este equipo; para internet, detrás de un proxy HTTPS)
# HH_WEB_HOST=127.0.0.1
# HH_WEB_PORT=4321
# HH_WEB_SECURE_COOKIE=1
