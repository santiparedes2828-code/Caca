      { "role": "sans", "family": "Inter", "weight": "700", "style": "normal", "src": "static:fonts/inter-latin-700-normal.woff2" },
      { "role": "sans", "family": "Inter", "weight": "500", "style": "normal", "src": "static:fonts/inter-latin-500-normal.woff2" },
      { "role": "serif", "family": "EB Garamond", "weight": "700", "style": "italic", "src": "static:fonts/eb-garamond-latin-700-italic.woff2" },
      { "role": "mono", "family": "JetBrains Mono", "weight": "500", "style": "normal", "src": "static:fonts/jetbrains-mono-latin-500-normal.woff2" }
    ],
    "typography": {
      "headlineWeight": 800,
      "headlineTracking": "-0.055em",
      "headlineLineHeight": 0.95,
      "monoTracking": "0.08em"
