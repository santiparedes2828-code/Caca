    "transcription": { "provider": "elevenlabs", "model": "scribe_v2", "language": "es", "diarize": true, "tagAudioEvents": true, "lowConfidenceLogprob": -1 },
    "voice": { "provider": "elevenlabs", "voiceId": "1p905cdbJ1e1JQxhFTGJ", "name": "Rodrigo Zabú", "model": "eleven_v4", "language": "es" }
